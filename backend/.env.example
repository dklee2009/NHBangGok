# NCP API Hub (네이버 클라우드 플랫폼)
# https://www.ncloud.com/ 에서 발급
NAVER_CLIENT_ID=여기에_NCP_API_KEY_ID_입력
NAVER_CLIENT_SECRET=여기에_NCP_API_KEY_SECRET_입력

# Mock 모드: true = 실제 API 미사용, false = 네이버 API 사용
USE_MOCK=false

# 한국관광공사 LocgoHub 관광타겟 서비스 (공공데이터포털)
# https://www.data.go.kr/data/15128559/openapi.do 에서 발급 (Encoding 키 그대로 붙여넣기 가능)
TOUR_API_KEY=여기에_공공데이터포털_인증키_입력
